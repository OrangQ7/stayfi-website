{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stayfi.example/schemas/underwriting.schema.json",
  "title": "StayFi Underwriting Dossier",
  "description": "Strict structured output for an evidence-backed seasonal hotel underwriting review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deal_id",
    "synthetic",
    "hotel_profile",
    "source_files",
    "normalized_metrics",
    "evidence",
    "missing_data",
    "discrepancies",
    "risk_flags",
    "risk_band",
    "confidence",
    "recommended_terms",
    "review_required",
    "investor_summary"
  ],
  "properties": {
    "deal_id": { "type": "string", "minLength": 1 },
    "synthetic": { "type": "boolean" },
    "hotel_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "location", "rooms", "season_start", "season_end"],
      "properties": {
        "name": { "type": "string" },
        "location": { "type": "string" },
        "rooms": { "type": "integer", "minimum": 1 },
        "season_start": { "type": "string", "format": "date" },
        "season_end": { "type": "string", "format": "date" }
      }
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file_name", "category", "sha256", "synthetic"],
        "properties": {
          "file_name": { "type": "string" },
          "category": { "type": "string", "enum": ["hotel_profile", "pms", "bank", "financing_request", "other"] },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "synthetic": { "type": "boolean" }
        }
      }
    },
    "normalized_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "forward_booked_revenue", "historical_pms_revenue", "verified_bank_inflow", "occupancy_rate", "bank_reconciliation_gap_pct"],
      "properties": {
        "currency": { "type": "string", "enum": ["USD", "USDC"] },
        "forward_booked_revenue": { "type": "number", "minimum": 0 },
        "historical_pms_revenue": { "type": "number", "minimum": 0 },
        "verified_bank_inflow": { "type": "number", "minimum": 0 },
        "occupancy_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "bank_reconciliation_gap_pct": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "file_name", "locator", "excerpt"],
        "properties": {
          "claim": { "type": "string" },
          "file_name": { "type": "string" },
          "locator": { "type": "string" },
          "excerpt": { "type": "string" }
        }
      }
    },
    "missing_data": { "type": "array", "items": { "type": "string" } },
    "discrepancies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "summary", "recommended_action"],
        "properties": {
          "code": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] },
          "summary": { "type": "string" },
          "recommended_action": { "type": "string" }
        }
      }
    },
    "risk_flags": { "type": "array", "items": { "type": "string" } },
    "risk_band": { "type": "string", "enum": ["A", "A-", "B+", "B", "B-", "C", "decline"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "recommended_terms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["funding_amount_usdc", "face_value_usdc", "discount_pct", "revenue_share_pct", "maturity_date"],
      "properties": {
        "funding_amount_usdc": { "type": "number", "minimum": 0 },
        "face_value_usdc": { "type": "number", "minimum": 0 },
        "discount_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "revenue_share_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "maturity_date": { "type": "string", "format": "date" }
      }
    },
    "review_required": { "type": "boolean" },
    "investor_summary": { "type": "string", "minLength": 1 }
  }
}
